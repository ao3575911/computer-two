{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mission proposal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "objective",
    "location",
    "budget_units",
    "input_manifest",
    "success_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "enum": [
        "device",
        "cloud"
      ]
    },
    "budget_units": {
      "type": "integer",
      "minimum": 0
    },
    "input_manifest": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
